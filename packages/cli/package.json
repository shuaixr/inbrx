{
  "name": "@inbrx/cli",
  "version": "0.0.1-alpha.5",
  "description": "CLI for capturing local SMTP mail with inbrx.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaixr/inbrx.git"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "bin": {
    "inbrx": "./bin/inbrx.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node ./bin/inbrx.js start",
    "dev": "tsx watch ./src/cli.ts start",
    "test": "vitest run --exclude \"dist/**\"",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.reporter=lcov --exclude \"dist/**\"",
    "check": "tsc --noEmit -p tsconfig.json && node --check ./bin/inbrx.js && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@inbrx/web": "0.0.1-alpha.5",
    "commander": "^15.0.0",
    "hono": "^4.12.27",
    "mailparser": "^3.9.14",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.19.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^4.1.9",
    "nodemailer": "^9.0.3",
    "tsx": "^4.19.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
